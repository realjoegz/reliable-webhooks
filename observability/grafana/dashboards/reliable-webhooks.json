{
  "uid": "reliable-webhooks",
  "title": "reliable-webhooks",
  "schemaVersion": 41,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pending deliveries by state",
      "description": "Every replica reads the whole queue for these gauges, so the largest reading is shown and the readings are not added up.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (webhooks_deliveries)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Age of the oldest due delivery",
      "description": "How long the oldest delivery that a claim could take has been due. It grows when the replicas do not keep up.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "max(webhooks_oldest_due_age_seconds)",
          "legendFormat": "oldest due"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Attempts by outcome",
      "description": "Attempt rows written per second by all replicas. An attempt of unknown outcome is one whose replica recorded nothing before its lease ran out.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unknown" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(webhooks_delivery_attempts_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Time from creation to success",
      "description": "Of the deliveries that succeeded, from the creation of the delivery to the end of the request that was answered with a 2xx. The smallest bucket of the histogram is 1 s. Below it a quantile is interpolated and not measured: deliveries that all took less than a second read as 0.5 s and 0.99 s.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(webhooks_delivery_end_to_end_seconds_bucket[$__rate_interval])))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(webhooks_delivery_end_to_end_seconds_bucket[$__rate_interval])))",
          "legendFormat": "99th percentile"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open circuits",
      "description": "Active endpoints whose circuit is open. Their due deliveries are held and count as such in the first panel, except while a probe is due.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "max(webhooks_circuits_open)",
          "legendFormat": "open"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingest results",
      "description": "Answers of POST /v1/events per second by all replicas, by result.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(webhooks_ingest_requests_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
